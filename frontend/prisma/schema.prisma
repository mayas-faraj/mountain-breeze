generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id          Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  room_id     Int
  user_id     Int
  bill        Float    @db.Float
  from_date   DateTime @db.Date
  duration    Int
  services_id Int
  room        room     @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_room1")
  services    services @relation(fields: [services_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_servecies1")
  user        user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_booking_user1")

  @@index([room_id], map: "fk_booking_room1_idx")
  @@index([services_id], map: "fk_booking_servecies1_idx")
  @@index([user_id], map: "fk_booking_user1_idx")
}

model category {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(100)
  img_src String? @db.VarChar(255)
  img_alt String? @db.VarChar(80)
  cost    Float   @db.Float
  room    room[]
}

model contant {
  id        Int    @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name      String @db.VarChar(100)
  link      String @db.VarChar(255)
  icon      String @db.VarChar(255)
  is_social Int    @default(0)
}

model option {
  id    Int    @id
  name  String @unique(map: "name_UNIQUE") @db.VarChar(45)
  value String @db.VarChar(45)
}

model page {
  id              Int       @id @unique(map: "id_UNIQUE") @default(autoincrement())
  slug            String    @unique(map: "slug_UNIQUE") @db.VarChar(255)
  title           String    @db.VarChar(255)
  feature_img_src String    @db.VarChar(255)
  feature_img_alt String    @db.VarChar(80)
  content         String?   @db.Text
  section         section[]
}

model room {
  id           Int       @id @unique(map: "id_UNIQUE") @default(autoincrement())
  category_id  Int
  number       String    @unique(map: "number_UNIQUE") @db.VarChar(15)
  is_available Int       @default(1)
  category     category  @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_room_category")
  booking      booking[]

  @@index([category_id], map: "fk_room_category_idx")
}

model section {
  id            Int             @id @unique(map: "id_UNIQUE") @default(autoincrement())
  content       String?         @db.Text
  page_id       Int
  page          page            @relation(fields: [page_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_page1")
  section_image section_image[]

  @@index([page_id], map: "fk_section_page1_idx")
}

model section_image {
  id         Int     @id @unique(map: "id_UNIQUE") @default(autoincrement())
  img_src    String  @db.VarChar(255)
  img_alt    String  @db.VarChar(80)
  title      String? @db.VarChar(100)
  section_id Int
  section    section @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_section_image_section1")

  @@index([section_id], map: "fk_section_image_section1_idx")
}

model services {
  id          Int       @id @unique(map: "id_UNIQUE") @default(autoincrement())
  name        String    @unique(map: "name_UNIQUE") @db.VarChar(100)
  cost        Float     @db.Float
  img_src     String?   @db.VarChar(255)
  img_alt     String?   @db.VarChar(80)
  description String?   @db.Text
  booking     booking[]
}

model ticket {
  id      Int      @id @unique(map: "id_UNIQUE") @default(autoincrement())
  message String   @db.Text
  sent_at DateTime @default(now()) @db.DateTime(0)
  user_id Int
  user    user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ticket_user1")

  @@index([user_id], map: "fk_ticket_user1_idx")
}

model type {
  id    Int     @id
  name  String  @unique(map: "name_UNIQUE") @db.VarChar(50)
  venue venue[]
}

model user {
  id           Int       @id @unique(map: "id_UNIQUE") @default(autoincrement())
  first_name   String    @db.VarChar(100)
  last_name    String    @db.VarChar(100)
  username     String    @unique(map: "username_UNIQUE") @db.VarChar(50)
  password     String    @db.VarChar(50)
  email        String?   @db.VarChar(50)
  phone_number String    @unique(map: "phone_number_UNIQUE") @db.VarChar(100)
  is_disabled  Int?      @default(0)
  booking      booking[]
  ticket       ticket[]
}

model venue {
  id          Int           @id
  name        String        @unique(map: "name_UNIQUE") @db.VarChar(45)
  description String?       @db.VarChar(45)
  contact     String?       @db.VarChar(45)
  type_id     Int
  type        type          @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_venue_type1")
  venue_image venue_image[]

  @@index([type_id], map: "fk_venue_type1_idx")
}

model venue_image {
  id       Int     @id @unique(map: "id_UNIQUE") @default(autoincrement())
  img_src  String  @db.VarChar(255)
  img_alt  String  @db.VarChar(80)
  title    String? @db.VarChar(100)
  venue_id Int
  venue    venue   @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_image_venue1")

  @@index([venue_id], map: "fk_image_venue1_idx")
}
